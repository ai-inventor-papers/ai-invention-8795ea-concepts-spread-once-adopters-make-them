\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Confirmed indicators for rarefied cross field breadth ($O_{2r}$, $m=50$). Pooled partial Spearman correlations from DerSimonian--Laird random effects pooling across four held out domain groups. All seven survive Holm--Bonferroni correction.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:confirmed}{{1}{6}{Confirmed indicators for rarefied cross field breadth ($O_{2r}$, $m=50$). Pooled partial Spearman correlations from DerSimonian--Laird random effects pooling across four held out domain groups. All seven survive Holm--Bonferroni correction}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Openness composite and confirmation}{6}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Confound analysis: topical dispersion, not temporal churn}{6}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Partial Spearman correlation between home field openness (OPEN\_home) and rarefied cross field breadth ($O_{2r}$, $m=50$), controlling for the popularity baseline (second control rung), per evaluation body. Blue squares are the six nonselection bodies: four held out domain groups and the 2010--14 and 2015--17 onset cohorts. Square area is proportional to inverse variance (Fisher-$z$) weight, and horizontal lines are 95\% bootstrap CIs (2,000 bootstrap resamples of concepts); $n$ is the number of concepts analysed. The blue diamond spans the DerSimonian--Laird random effects pool over these six bodies, $+0.069$ [$+0.038$, $+0.100$] with $I^2=0$, and the dotted blue line marks the pooled estimate. The grey row is the DEV selection body ($+0.109$ [$+0.073$, $+0.144$], $n=3{,}003$), on which the index was chosen. It is not part of the pool and is $1.58\times $ the pooled estimate, consistent with winner's curse shrinkage. The dashed grey line marks zero. All six nonselection estimates are positive, but only the two cohort intervals exclude zero. Because five of the six bodies had been unsealed earlier, the pool is descriptive rather than confirmatory.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:evidence_synthesis}{{1}{7}{Partial Spearman correlation between home field openness (OPEN\_home) and rarefied cross field breadth ($O_{2r}$, $m=50$), controlling for the popularity baseline (second control rung), per evaluation body. Blue squares are the six nonselection bodies: four held out domain groups and the 2010--14 and 2015--17 onset cohorts. Square area is proportional to inverse variance (Fisher-$z$) weight, and horizontal lines are 95\% bootstrap CIs (2,000 bootstrap resamples of concepts); $n$ is the number of concepts analysed. The blue diamond spans the DerSimonian--Laird random effects pool over these six bodies, $+0.069$ [$+0.038$, $+0.100$] with $I^2=0$, and the dotted blue line marks the pooled estimate. The grey row is the DEV selection body ($+0.109$ [$+0.073$, $+0.144$], $n=3{,}003$), on which the index was chosen. It is not part of the pool and is $1.58\times $ the pooled estimate, consistent with winner's curse shrinkage. The dashed grey line marks zero. All six nonselection estimates are positive, but only the two cohort intervals exclude zero. Because five of the six bodies had been unsealed earlier, the pool is descriptive rather than confirmatory}{figure.1}{}}
